#!/bin/sh
# Source launcher: choose an installed supported interpreter without installing one.
set -eu
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for task_python in python3.14 python3.13 python3.12 python3.11 python3; do
    if command -v "$task_python" >/dev/null 2>&1 &&
       "$task_python" -c 'import sys; raise SystemExit(sys.version_info < (3, 11))' 2>/dev/null; then
        cd "$task_root"
        export PYTHONPATH="$task_root/src"
        exec "$task_python" -B -m shake_bake gui "$@"
    fi
done
printf '%s\n' 'Python 3.11 or newer is required. Install a supported Python, then run this launcher again.' >&2
exit 2
